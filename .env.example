# Optional local-development identity. Never set this in hosted production;
# Sites supplies authenticated identity headers after Sign in with ChatGPT.
HALOVIA_LOCAL_USER_EMAIL=

# The Android prototype (mobile/, android/) needs no keys or secrets: map tiles,
# routing and place lookups use public OpenStreetMap services (OpenFreeMap, OSRM,
# Overpass) without API keys.

# Live SOS (Firebase). The Android app reads its Firebase config from
# android/app/google-services.json, so these are only for running the app in
# a browser. Copy them into .env.local (git-ignored).
# Against the local emulators (cd firebase && npx firebase emulators:start ...):
#   VITE_FIREBASE_API_KEY=demo-key
#   VITE_FIREBASE_PROJECT_ID=demo-halovia
#   VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# Against your real project (Project settings → General → Web app config):
#   VITE_FIREBASE_API_KEY=
#   VITE_FIREBASE_PROJECT_ID=
#   VITE_FIREBASE_APP_ID=
#   VITE_FIREBASE_SENDER_ID=
